# Ignore all by default; keep only backend tracked
*
!/.gitignore
!/.gitattributes
!/FULLPOS_BACKEND/
!/FULLPOS_BACKEND/**
!/FULLPOS_OWNER/
!/FULLPOS_OWNER/**

# Keep generated Flutter artifacts ignored inside tracked projects
FULLPOS_OWNER/.dart_tool/
FULLPOS_OWNER/build/
FULLPOS_OWNER/.idea/
FULLPOS_OWNER/.idea/**
FULLPOS_OWNER/**/*.iml
FULLPOS_OWNER/.flutter-plugins
FULLPOS_OWNER/.flutter-plugins-dependencies
FULLPOS_OWNER/.packages
FULLPOS_OWNER/build_verbose_owner*.txt

# Do not commit generated installers or binary release artifacts.
FULLPOS_OWNER/installer/
FULLPOS_OWNER/installer/output/
FULLPOS_OWNER/installer/redist/
FULLPOS_OWNER/release/
FULLPOS_OWNER/assets/imagen/
FULLPOS_OWNER/**/*.exe
FULLPOS_OWNER/**/*.msi
FULLPOS_OWNER/**/*.zip
FULLPOS_OWNER/**/*.apk
